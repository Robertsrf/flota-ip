# Frontend (Vite). Solo la llave pública: la llave secreta (service_role) jamás va aquí.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-llave-publica-anon
# Dominio interno para el login con usuario + PIN (correo sintético que nunca recibe nada)
VITE_DOMINIO_USUARIOS=usuarios.flota-ip.invalid
# Ruta base del sitio (GitHub Pages: /nombre-del-repo/)
VITE_BASE=/

# Solo para scripts locales (no se usan en el navegador)
SUPABASE_PROJECT_REF=tu-ref-de-proyecto
